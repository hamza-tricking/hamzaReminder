# Copy this file to .env and fill the values. Never commit .env.

# Token from @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=

# Your chat id. Leave empty first, send /start to the bot, and it will reply with your id.
TELEGRAM_CHAT_ID=

# Time zone offset from UTC in minutes. Algeria is UTC+1 all year (no daylight saving).
TZ_OFFSET_MIN=60

# How often a reminder repeats until you press the button
REPEAT_EVERY_MIN=5

# Stop repeating after this many minutes and tell you it expired
MAX_REPEAT_MIN=120
